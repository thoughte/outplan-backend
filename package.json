{
  "name": "outplan-backend",
  "version": "1.0.0",
  "description": "outplan API. A plan you can argue with.",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "config:fingerprint": "ts-node ./scripts/fingerprint.ts",
    "diag": "ts-node ./scripts/diagnose.ts",
    "transcript": "ts-node ./scripts/transcript.ts",
    "import:record": "ts-node ./scripts/import-record.ts",
    "canonicalise": "ts-node scripts/canonicalise.ts",
    "migrate:rest": "ts-node scripts/migrate-rest.ts",
    "upload:record": "ts-node scripts/upload-record.ts",
    "docs:check": "ts-node scripts/docs-check.ts",
    "db:check": "prisma migrate diff --from-schema prisma/schema.prisma --to-config-datasource prisma.config.mjs --exit-code",
    "goals:dupes": "npx --yes tsx scripts/goal-dupes.ts",
    "prompt:show": "npx --yes tsx scripts/prompt-publish.ts",
    "prompt:publish": "npx --yes tsx scripts/prompt-publish.ts --publish",
    "try": "npx --yes tsx scripts/try-chat.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1",
    "gaxios": "^7.1.3"
  }
}
