// outplan backend schema.
//
// Prisma owns the ordinary relational models here. It does NOT own the
// knowledge tree: ltree paths, generated tsvector columns and pgvector live in
// raw SQL migrations and are read through $queryRaw in a repository layer.
// See .claude/tech-stack.md for why, and for what was rejected.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here. Prisma 7 removed it: the connection string lives in
  // prisma.config.ts for Migrate, and reaches the client through the pg adapter
  // in src/lib/prisma.ts. One source, read once, in env.config.
}

enum Role {
  member
  clinician
  admin
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      Role     @default(member)
  /// Their name AS IT APPEARS ON MEDICAL REPORTS, which is why it is asked for
  /// that way on screen.
  ///
  /// This is a safety field, not a courtesy. It is the only thing standing
  /// between a household member's blood test and someone else's permanent
  /// record: every uploaded report is checked against it before a single number
  /// is read. "Kunal" does not match a report printed as "Mr KUNAL KHANNA", and
  /// someone who types a nickname has quietly disabled that check.
  ///
  /// Until this existed the check compared against a string literal in two
  /// source files, so it worked for exactly one person and silently did nothing
  /// for everyone else.
  name String?

  /// A date, never an age. Age is a number that rots without anyone touching
  /// it; a birth date stays true. Most of what a marker means depends on it.
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  /// Where they live. NOT ASKED FOR YET.
  ///
  /// It was briefly a free-text box, which was a mistake: "kanpur", "Kanpur"
  /// and "Kanpur, UP" cannot be grouped or checked, and the timezone was being
  /// taken from the device regardless - so the field asked a question and then
  /// ignored the answer.
  ///
  /// The column stays because a picked city is the right long-term source for
  /// the clock. It stays empty until there is something to pick from.
  city String?

  /// IANA zone. Still defaulted so nothing breaks before setup runs, but the
  /// default is now a placeholder rather than an assumption: the app knows the
  /// profile is incomplete and says so.
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @map("created_at")

  exchanges   Exchange[]
  corrections Correction[]
  sessions    AuthSession[]

  /// Everything older than the live context window, compacted into prose.
  ///
  /// Without this, a long history is simply lost: the window fills, the oldest
  /// turns fall off the end, and something told two hundred messages ago stops
  /// existing. The summary is what makes the memory outlast the window.
  contextSummary        String?   @map("context_summary") @db.Text
  /// Everything said up to and including this moment is inside the summary.
  /// Anything after it is still in the live window and must not be summarised
  /// twice - that is how a summary drifts into saying things that never happened.
  contextSummaryThrough DateTime? @map("context_summary_through")

  reports       Report[]
  files         StoredFile[]
  agentKeys     AgentKey[]
  planItems     PlanItem[]
  goals         Goal[]
  farm          Farm?
  invites       Invite[]
  careOwned     CareLink[]    @relation("careOwner")
  careViewing   CareLink[]    @relation("careViewer")
  discoveries   Discovery[]
  subscription  Subscription?
  measurements  Measurement[]
  symptoms      Symptom[]
  interventions Intervention[]
  observations  Observation[]
  markers       GeneticMarker[]

  @@map("users")
}

/// One signed-in device.
///
/// Firebase alone cannot answer "where am I logged in" or "log out that phone"
/// - it has no way to enumerate a user's live tokens, and revokeRefreshTokens
/// kills every device at once. This table is what makes both possible, and for
/// a record holding someone's medications that is not a nicety.
///
/// A request must carry BOTH a valid Firebase token and a live session id. A
/// stolen token alone is therefore not enough, which is a security gain on top
/// of the feature.
model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the person will recognise in a list: "Chrome on macOS".
  label     String?
  userAgent String? @map("user_agent") @db.Text

  /// Kept for "signed in from somewhere new", not for geolocation. Truncated to
  /// a /24 before storage - enough to notice a change, not enough to place
  /// someone at an address.
  ipPrefix String? @map("ip_prefix")

  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  /// Revoked rather than deleted. "This device was signed out at 3am" is
  /// something the person may need to see afterwards, and a deleted row cannot
  /// tell them.
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by")

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// One thing the person said, and what came back.
///
/// `said` is stored BEFORE anything interprets it. The parse, the engine state
/// and the reply are all derived columns - if any of them is wrong, the
/// original is still here to derive again. A record that keeps only the
/// interpretation cannot be re-read when the interpreter turns out to be wrong,
/// and this interpreter has been wrong five times in ten days.
model Exchange {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  said   String   @db.Text
  saidAt DateTime @default(now()) @map("said_at")
  /// 'YYYY-MM-DD' in the PERSON'S timezone, as text rather than a date column.
  /// A date read back by a client in another zone can shift by a day, and "which
  /// day did I eat that" must not depend on where the reader is standing. Text
  /// sorts and ranges correctly and cannot be reinterpreted.
  localDay String @map("local_day") @db.VarChar(10)

  /// What the deterministic engines made of it: parsed meal, totals, flags,
  /// which rules fired. Null means nothing recognised it, which is a fact worth
  /// keeping rather than an absence to fill in later.
  parsed Json?

  /// What was replied, and what produced it. promptVersion and model are here so
  /// a bad answer can be traced to the configuration that produced it - without
  /// them, an eval cannot tell a prompt regression from a model change.
  replied       String?  @db.Text

  /// The reply as it should be SHOWN: a short sequence of message bubbles, and
  /// optionally one question with tappable options.
  ///
  /// `replied` stays the flat joined text, because that is what the next turn's
  /// history needs - a model reading its own previous answer does not need to
  /// know it arrived in three bubbles. Rendering and remembering are different
  /// jobs and this is the seam between them.
  ///
  /// Shape: { messages: string[], question?: { text: string, options: string[] } }
  replyParts    Json?    @map("reply_parts")

  /// What the assistant DID for them on this message, if anything.
  ///
  /// One entry per operation it ran: the name, what it was given, what came
  /// back, and the line shown under the reply. A write the person cannot see is
  /// a write they cannot object to, so every one appears here and every one can
  /// be undone from here.
  ///
  /// Shape: [{ id, name, input, result, say }]
  didThings     Json?    @map("did_things")

  /// This message was sent with an agent key, not typed by them.
  ///
  /// It exists so a rehearsal can go through the real path without becoming
  /// part of their conversation. Nothing is read out of one into the record,
  /// and the screen marks it, because a line they never wrote sitting
  /// unmarked in their own chat is the one thing this must never produce.
  viaAgent      Boolean  @default(false) @map("via_agent")

  repliedAt     DateTime? @map("replied_at")
  model         String?
  promptVersion String?  @map("prompt_version")

  corrections Correction[]

  @@index([userId, localDay])
  /// When several messages arrive before any answer, one reply covers them all
  /// and the earlier ones point at it.
  ///
  /// Someone types "I had momos", then "with red chutney", then "post dinner"
  /// in three taps. Answering each separately is three replies to one thought.
  /// Answering only the last leaves the first two sitting there with nothing
  /// under them, which looks exactly like being ignored - and that is what
  /// happened before this existed.
  coveredById String?    @map("covered_by_id") @db.Uuid
  coveredBy   Exchange?  @relation("covers", fields: [coveredById], references: [id], onDelete: SetNull)
  covers      Exchange[] @relation("covers")

  /// This message answers the question asked in THAT exchange's reply.
  ///
  /// Set when he taps one of the offered options. Without it a tapped answer
  /// arrives as a bare word: "Boiled" is stored as a message about nothing, the
  /// extractor reads it as a message about nothing, and the assistant cannot
  /// tell a tapped answer from a change of subject. It is also the only thing
  /// that makes "close what you opened" checkable rather than aspirational,
  /// because until now the assistant's own questions were the one side of the
  /// conversation nothing tracked.
  answeringId String?    @map("answering_id") @db.Uuid
  answering   Exchange?  @relation("answers", fields: [answeringId], references: [id], onDelete: SetNull)
  answers     Exchange[] @relation("answers")

  observations Observation[]
  goals        Goal[]

  /// "what has this person said that never got an answer" runs on every
  /// incoming message, to fold back-to-back messages into one reply.
  @@index([userId, repliedAt])
  /// Created by the migration that added `answering`, declared here later when
  /// db:check reported it. "Which message answered this question" is a lookup
  /// by the answered exchange, and without the index it is a scan.
  @@index([answeringId])

  @@map("exchanges")
}

/// The person telling us we were wrong, and what was right instead.
///
/// A ROW, never an edit. The original reply stays. A wrong answer plus the
/// correct one plus the reason is the training pair, and editing the original
/// destroys the half that is hard to get. This is the only data in this product
/// that cannot be bought.
model Correction {
  id         String   @id @default(uuid()) @db.Uuid
  exchangeId String   @map("exchange_id") @db.Uuid
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// In the person's own words. Not a category, not a rating.
  wasWrong  String  @map("was_wrong") @db.Text
  isRight   String? @map("is_right") @db.Text

  /// Which knowledge branch this bears on, for later grouping. Nullable: forcing
  /// a domain at capture time would make the person classify their own
  /// correction, and a misfiled correction is worse than an unfiled one.
  domain String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("corrections")
}

/// Runtime configuration, changeable without a redeploy.
///
/// Only three things stay in the environment: DATABASE_URL, and the two
/// Anthropic values. Everything else lives here - the owner's instruction, and
/// the right call: a CORS origin or a model name that requires a rebuild to
/// change is not configuration, it is a constant with extra steps.
///
/// Values are jsonb so a setting can be a string, a number, a list or an object
/// without a schema change every time one is added.
model AppConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("app_config")
}

/// A system prompt, versioned.
///
/// Prompts live here rather than in source for one reason that matters: an
/// answer must be traceable to the exact text that produced it. Exchange stores
/// promptVersion, so when a reply turns out to be wrong it is possible to say
/// which prompt said it - and an eval can tell a prompt regression apart from a
/// model change. A prompt edited in place makes both impossible.
///
/// Rows are never updated. A change is a new version; activation moves.
model Prompt {
  id      String @id @default(uuid()) @db.Uuid
  key     String
  version Int

  content String  @db.Text
  notes   String? @db.Text

  /// Exactly one version per key is active. Enforced by a partial unique index
  /// in a raw migration - Prisma cannot express "unique where active".
  active Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, active])
  @@map("prompts")
}

// ---------------------------------------------------------------- the record
//
// Everything below is the person's own health record. It is separate from
// exchanges on purpose: a conversation is what was said, a record is what is
// true, and the two decay at completely different rates. A meal logged in chat
// is interesting for a week; a testosterone result matters for years.

enum ReportKind {
  blood
  urine
  genetic
  imaging
  body_metrics
  self_reported
  other
}

enum SymptomStatus {
  active
  improving
  resolved
}

enum InterventionKind {
  medication
  supplement
  protocol
}

/// One measurement event - a blood draw, a scan, a set of numbers.
model Report {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The date the SAMPLE was taken, never the date the lab issued the report.
  /// Trends are only meaningful against collection dates, and the two can be
  /// weeks apart.
  collectedOn DateTime   @map("collected_on") @db.Date
  kind        ReportKind
  lab         String?
  fasting     Boolean?
  notes       String?    @db.Text

  measurements Measurement[]
  markers      GeneticMarker[]

  @@index([userId, collectedOn])
  /// Matching an uploaded PDF to the report it is.
  @@index([userId, bookingRef])
  /// The lab's own reference for this booking, as printed on the report. It is
  /// what tells two blood tests collected on the SAME DAY apart - he has two
  /// from 22 Apr 2023 - which a date alone cannot do, and it is how an uploaded
  /// PDF is matched to the report it belongs to rather than guessed at.
  bookingRef String? @map("booking_ref")

  /// The filename this report was originally read from, back when the record
  /// lived in SQLite. Kept even before the file itself is uploaded: it is the
  /// only surviving evidence of where these numbers came from.
  sourceName String? @map("source_name")

  /// The uploaded file this report was read out of, when there is one. Null for
  /// the eight imported from the old SQLite record before any file existed.
  sourceFileId String?     @map("source_file_id") @db.Uuid
  sourceFile   StoredFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@map("reports")
}

/// One value from one report.
model Measurement {
  id       String @id @default(uuid()) @db.Uuid
  reportId String @map("report_id") @db.Uuid
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Canonical key, e.g. testosterone_total. The printed label is kept too,
  /// because labs name the same analyte differently and the printed form is the
  /// only way to check a mapping later.
  variable String
  label    String?

  value     Float?
  valueText String? @map("value_text")
  unit      String?
  panel     String?
  /// Assay method. Two labs measuring the same thing differently produce a
  /// trend that is an artefact, and without this nobody can tell.
  method    String?
  notes     String? @db.Text

  /// Denormalised from the report so a trend query does not need the join.
  collectedOn DateTime @map("collected_on") @db.Date

  /// The same number in one unit per marker, so a chart can plot a decade of
  /// readings without every point having to be reasoned about first.
  ///
  /// `value` and `unit` above are never touched - they are what the lab printed
  /// and the only way to re-check a conversion later. These two are derived.
  /// Without them, wbc_count reported once as "4700 cumm" beside readings of
  /// "6.8 10^3/uL" draws a 700x spike that is really the lowest point on the
  /// chart, and free testosterone appears to fall when it rose.
  canonicalValue Float?  @map("canonical_value")
  canonicalUnit  String? @map("canonical_unit")
  /// Set when the conversion was REFUSED, with the reason. A row where the
  /// printed unit and the printed value disagree - platelets as "190000
  /// thou/mm3" - must not be quietly rewritten into whatever makes the chart
  /// look right. It is left unplotted and visible instead.
  canonicalFlag  String? @map("canonical_flag")

  /// Which file this number was read from. Denormalised deliberately: "show me
  /// the page this came from" must not depend on the report still existing, or
  /// on a report having exactly one source.
  sourceFileId String?     @map("source_file_id") @db.Uuid
  sourceFile   StoredFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([userId, variable, collectedOn])
  /// "show me every number that came off this scan" is the verification
  /// question, and it should not be a sequential scan of the whole table.
  @@index([sourceFileId])
  @@map("measurements")
}

/// Something the person is experiencing, and what is known about it.
model Symptom {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  /// The full reasoning: mechanism, what rules it in, what rules it out. Long
  /// by design and never shown whole to the model - the brief takes the name
  /// and the status, and this is here for when someone asks.
  detail     String?       @db.Text
  status     SymptomStatus @default(active)
  reportedOn DateTime      @map("reported_on") @db.Date
  resolvedOn DateTime?     @map("resolved_on") @db.Date

  @@index([userId, status])
  @@map("symptoms")
}

/// A medicine, supplement or protocol, and whether it is still running.
model Intervention {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  kind      InterventionKind
  dose      String?
  schedule  String?
  startedOn DateTime? @map("started_on") @db.Date
  /// Set rather than deleting the row. What someone used to take, and when they
  /// stopped, is clinical information - a deleted row cannot say either.
  stoppedOn DateTime? @map("stopped_on") @db.Date
  reason    String?   @db.Text
  notes     String?   @db.Text

  @@index([userId, stoppedOn])
  planItems PlanItem[]
  goals     Goal[]

  @@map("interventions")
}

/// A day's worth of what actually happened - meals, sleep, adherence, symptoms.
model Observation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'YYYY-MM-DD' in the person's timezone, as text. A date column read by a
  /// client elsewhere can shift by a day, and which day something happened must
  /// not depend on where the reader is standing.
  localDay String @map("local_day") @db.VarChar(10)
  variable String
  value    String @db.Text
  notes    String? @db.Text

  /// How much, when they said how much.
  ///
  /// The value stays their own words - "around 1.5 litres", "slept maybe 5
  /// hours" - because that is what they told us. These two are the number
  /// pulled out of it, and without them nothing can react to an AMOUNT: the
  /// farm could only tell whether something was logged, which rewards talking
  /// about sleep rather than sleeping.
  ///
  /// Null is normal and not a failure. "Had momos" has no amount, and a meal is
  /// still a meal.
  amount Float?
  unit   String?

  /// Said, but not yet done.
  ///
  /// "I will have veg biryani in 30 mins" is not a meal, it is an intention -
  /// and the first version of extraction filed it as one, with the word
  /// "planned" buried in the notes while the row itself asserted he had eaten.
  /// If he skips it his record says otherwise, and anything counting what he
  /// actually ate counts it.
  ///
  /// Kept rather than discarded, because what he intends is worth knowing and
  /// he took the trouble to say it. It simply must not be mistaken for what
  /// happened.
  planned Boolean @default(false)

  /// What they CLAIMED about it, not just what it was.
  ///
  /// One of: did, will, did-not, used-to, considering, asking-about. Only 'did'
  /// is a thing that happened, and only 'did' ticks anything off the day plan.
  ///
  /// It supersedes `planned`, which was a boolean over a space with at least
  /// six values and whose fallback was "they did it". Anything the model could
  /// not represent fell through to that fallback: "I should stop the
  /// magnesium", "I used to take that", "the doctor said take it" are none of
  /// them future tense, so each would have entered the record as a dose taken
  /// today.
  ///
  /// The default here exists only so the column can be added to a live table.
  /// Nothing writes it by default: extraction DROPS an item whose modality it
  /// cannot classify rather than assuming one, the same way it already drops an
  /// unrecognised kind.
  said String @default("did")

  /// The message this was read out of, when it came from a conversation.
  ///
  /// Provenance, the same rule as a measurement pointing at the page it was
  /// printed on: he must be able to ask "why does my record say I ate momos at
  /// 2am" and be shown the sentence he typed. Null for the 78 rows imported
  /// from the old SQLite record, which predate any message.
  ///
  /// It also carries the TIME for free. localDay says which day; the exchange
  /// says when, which is the whole question for a meal near bedtime.
  exchangeId String?   @map("exchange_id") @db.Uuid
  exchange   Exchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  planItems PlanItem[]

  @@index([userId, localDay])
  @@index([userId, variable, localDay])
  /// Created by the migration that added `said`, and left out of the schema
  /// until db:check reported the difference. It exists so "what did they say
  /// they WOULD do" is an index read rather than a scan of every observation.
  @@index([userId, said])
  @@map("observations")
}

/// A genetic result. Kept whole, deliberately excluded from the assistant's
/// brief: 573 markers would drown every other fact, and almost none of them
/// change what to do tomorrow.
model GeneticMarker {
  id       String  @id @default(uuid()) @db.Uuid
  reportId String  @map("report_id") @db.Uuid
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  section  String?
  trait    String
  gene     String?
  snp      String?
  genotype String?
  result   String?
  notes    String? @db.Text

  @@index([userId, trait])
  @@map("genetic_markers")
}

/// A file the person uploaded: a lab PDF, a scan, a plan, a spreadsheet.
///
/// The rule this model exists to enforce: a report is DIGESTED EXACTLY ONCE.
/// Digesting writes measurements and a Report into the database, and from that
/// moment the database is the only thing the reasoning engine reads. The file
/// itself is kept so the person can open the original in the app - provenance
/// and a viewer, not a second source of truth.
///
/// Which is why `hash` is unique per person rather than merely convenient. The
/// same PDF mailed twice, or re-uploaded after a failed connection, must not
/// double his measurements - and a record that silently doubles a reading is
/// worse than one that rejects a file.
model StoredFile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the bytes. The digest-once guarantee, and the only reliable way
  /// to know two uploads are the same file - names and dates are not.
  hash      String
  filename  String
  mediaType String  @map("media_type")
  bytes     Int
  /// Path on the files volume, relative to FILES_DIR. Relative so the volume can
  /// be remounted anywhere without rewriting every row.
  path      String

  kind   FileKind
  status FileStatus @default(current)

  /// The app's own material: kept because it is theirs, never listed as theirs
  /// to read.
  ///
  /// Nine markdown documents on the owner's account were written by the app's
  /// tooling during the one migration this product will ever do, and filed
  /// under kind 'plan' as if a person had uploaded them. They then sat on the
  /// Records screen beside his blood tests. His rule, 20 Sep 2026: no generated
  /// document belongs to a user. What such a document holds is digested into
  /// rows; the file stays as provenance and nothing more. The list and content
  /// endpoints both exclude these, so there is no path from a screen to them.
  internal Boolean @default(false)

  /// The date the CONTENT is about - when blood was drawn, when a plan was
  /// written. NOT when the file was uploaded. A scan of a March test uploaded
  /// today is March data, and charting it as today would be a lie.
  contentDate DateTime? @map("content_date") @db.Date
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  /// The text pulled out of the file, kept here because the engine reads the
  /// database and never opens a file. For a plan this is what lets the app quote
  /// his own words back to him.
  text String? @db.Text

  /// Digest bookkeeping. `digestedAt` null means the bytes are stored but
  /// nothing has been read out of them yet; `digestNote` says why when that was
  /// deliberate - no verified collection date, for instance, which under his own
  /// rules blocks ingestion without throwing the file away.
  /// What reading the file found: the lab's booking reference, the collection
  /// date and how many pages. Columns rather than a text search, because
  /// searching text for a booking number matches every OTHER report from the
  /// same visit - his blood panel and his DNA report share one reference, and
  /// treating them as copies of each other loses the provenance of both.
  bookingRef String? @map("booking_ref")
  pages      Int?

  digestedAt DateTime? @map("digested_at")
  digestNote String?   @map("digest_note")

  /// What was read out of this file. Provenance points FROM the record TO the
  /// file, not the other way round: one scan can yield a whole report, and one
  /// report can be assembled from several scans, so a single report_id on the
  /// file cannot express it.
  reports      Report[]
  measurements Measurement[]

  @@unique([userId, hash])
  @@index([userId, kind, contentDate])
  /// Finding the file that carries a given booking reference.
  @@index([userId, bookingRef])
  @@map("stored_files")
}

enum FileKind {
  report
  /// No longer accepted on upload. The app builds plans; a person does not
  /// upload one. The rows that carry it came from the owner's migration and are
  /// marked internal.
  plan
  scan
  note
  other
}

enum FileStatus {
  current
  superseded
  draft
}

/// What each measurement name MEANS. Reference data, not anyone's record - so
/// no user_id: the dictionary is the same for everybody and belongs to the
/// product, not to a person.
///
/// It is what turns "vitamin_d_25oh" into "Vitamin D (25-OH)" on a chart axis,
/// and what lets a lab's printed label be recognised as a marker already being
/// tracked. Without it, the same analyte printed two ways starts two separate
/// lines on a graph that should have been one.
model VariableCatalog {
  /// The canonical key, matching Measurement.variable.
  variable    String  @id
  displayName String? @map("display_name")
  /// What this marker is normally reported in. A default for display, never a
  /// reason to rewrite a value - the lab's own unit stays on the measurement.
  defaultUnit String? @map("default_unit")
  category    String?
  /// Other printed names for the same analyte, as labs write them.
  aliases     String[] @default([])

  @@index([category])
  @@map("variable_catalog")
}

/// A key that lets something which is not a person act as this person.
///
/// Kunal's objection, 18 Sep 2026, and it is a fair one: I kept his entire
/// health record for months, then built an app I have no access to. The agent
/// doing the work cannot reach the record it maintains.
///
/// So this exists - but as a KEY, never as a backdoor, and the difference is
/// the whole point. A backdoor is a path around authentication: invisible,
/// unrevocable, indistinguishable from a break-in, and in a product that will
/// hold other people's blood tests it is the single worst thing that could be
/// built. A key is a credential like any other. It is listed beside his phones,
/// it says when it was last used, one tap ends it, and every request it makes is
/// attributable to it rather than blending in with his own.
///
/// The secret is stored as a hash. A database that leaks must not hand over
/// working access to a health record, and nobody - including me - can read back
/// a key that was issued.
model AgentKey {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What this key is for, in his words. Shown wherever it is listed, because
  /// "revoke this" is only a real choice if he can tell which one it is.
  label String

  /// SHA-256 of the secret. The secret itself is shown once, at creation, and
  /// never exists anywhere again.
  tokenHash String @unique @map("token_hash")

  /// What it may do. Deliberately narrow: this key exists to move records in,
  /// not to speak as him. Nothing here grants the talk endpoints, so a leaked
  /// key cannot put words in his conversation or read it back.
  scopes String[] @default(["files:read", "files:write", "record:read"])

  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  /// Set rather than deleted: a key that was used and then withdrawn is part of
  /// the history of who touched this record.
  revokedAt  DateTime? @map("revoked_at")
  /// Belt and braces. A key that outlives its purpose is a key nobody remembers
  /// issuing.
  expiresAt  DateTime? @map("expires_at")

  @@index([userId, revokedAt])
  @@map("agent_keys")
}

/// One thing to do today.
///
/// The Today screen used to count messages and replay the transcript, which
/// tells someone nothing they did not already know. What a person actually
/// wants at 9am is the short list of what they are meant to do, and at 11pm
/// whether they did it.
///
/// Items are GENERATED from the record rather than typed in: his five
/// breakfast tablets and his 20:00 magnesium are already in `interventions`
/// with their schedules, and a to-do list that has to be maintained separately
/// from the record is a to-do list that will disagree with it.
model PlanItem {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'YYYY-MM-DD' in their timezone. Text, for the same reason as Observation:
  /// which day something belongs to must not depend on where the reader is.
  localDay String @map("local_day") @db.VarChar(10)

  /// Stable per source per day, e.g. "intervention:<uuid>". Regenerating a day
  /// must not produce a second copy of the same tablet, and it must not wipe
  /// out what has already been ticked.
  key String

  title  String
  detail String?
  /// 'HH:MM' when the record says when. Null for "with breakfast", which is a
  /// time of day rather than a time - inventing 08:00 for it would put a
  /// precise deadline on something that never had one.
  atLocal String? @map("at_local") @db.VarChar(5)
  /// Lower sorts first. Morning things before evening things.
  sortOrder Int @default(0) @map("sort_order")

  /// The goal this quest serves, when it is one. Ticking it is what moves that
  /// goal's adherence, so the link is the whole point rather than decoration.
  goalId String? @map("goal_id") @db.Uuid
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  source         PlanSource
  interventionId String?       @map("intervention_id") @db.Uuid
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  status PlanStatus @default(pending)
  doneAt DateTime?  @map("done_at")
  /// How it was marked: he tapped it, or he said he had done it and the
  /// observation that proved it. Worth keeping separate - "I ticked this" and
  /// "the app decided I meant this" are different levels of certainty, and if
  /// the matching ever goes wrong this is how it is found.
  doneVia       DoneVia?     @map("done_via")
  observationId String?      @map("observation_id") @db.Uuid
  observation   Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, localDay, key])
  @@index([userId, localDay, sortOrder])
  @@map("plan_items")
}

enum PlanSource {
  intervention
  /// A quest: today's face of a behaviour goal. Not a separate system - a goal
  /// says "in bed by midnight", and this is the line for tonight.
  goal
  manual
}

enum PlanStatus {
  pending
  done
  skipped
}

enum DoneVia {
  tap
  said
}

/// Something he is trying to change, broken down until each piece is small
/// enough to actually finish.
///
/// His insight, 19 Sep 2026, and it is the whole design: "go meds free" is not
/// one goal. Every medicine exists for a REASON, and to be free of it you fix
/// the reason. His six daily tablets decompose into ApoB down, B12 up,
/// homocysteine down, twitching gone, B6 measured, thiamine repleted. One
/// sentence, six goals, four of them trackable today.
///
/// And it recurses. Any goal splits again until the leaves are atomic: a number
/// to move, or a thing to do. Small scope helps twice over - he finishes things
/// often enough to feel it, and "28 goals this year" is a true sentence rather
/// than a slogan.
model Goal {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  /// Why this is a goal at all, in the record's own words. For the meds tree
  /// this is the intervention's `reason`, which is where the decomposition came
  /// from in the first place.
  why   String? @db.Text

  kind GoalKind

  /// Decomposition: this goal is PART OF that one.
  parentId String? @map("parent_id") @db.Uuid
  parent   Goal?   @relation("breakdown", fields: [parentId], references: [id], onDelete: Cascade)
  children Goal[]  @relation("breakdown")

  /// Ordering: this goal cannot start until those are done. Separate from
  /// parent/child on purpose - "thiamine repletion before any alcohol
  /// reduction" is not a part-of relationship, it is a sequence, and collapsing
  /// the two would make alcohol a component of thiamine, which it is not.
  blockedBy GoalBlock[] @relation("blocked")
  blocking  GoalBlock[] @relation("blocker")

  /// What to read to know where this stands. A measurement variable for an
  /// outcome, an observation kind for a behaviour. Null on a container, whose
  /// progress is its children's.
  measure String?

  /// The honest starting number. Without it nothing can report progress, which
  /// is why a goal can sit in waiting_baseline rather than pretending.
  baselineValue Float?    @map("baseline_value")
  baselineText  String?   @map("baseline_text")
  baselineAt    DateTime? @map("baseline_at")

  targetValue Float?        @map("target_value")
  targetText  String?       @map("target_text")
  direction   GoalDirection @default(down)

  status     GoalStatus @default(proposed)
  achievedAt DateTime?  @map("achieved_at")

  /// True when nothing in the record says this, and it was reasoned to rather
  /// than read off. The inflammation branch is the case: hs-CRP, CRP, uric acid
  /// and BMI were grouped as the thing sitting underneath everything else, and
  /// that grouping appears in no medicine's reason.
  ///
  /// It is kept, not deleted, because his theory is never stupid and neither is
  /// a good inference. But it stands apart: confirming a container does NOT
  /// cascade into an inferred child, and the screen says where it came from.
  /// Never cleared on confirm, because it is provenance and provenance does not
  /// stop being true once somebody agrees with it.
  inferred Boolean @default(false)

  /// Where it came from: the sentence he said, the message it was said in, and
  /// the medicine it would free him from. Provenance for a goal, same rule as
  /// everything else here - he should be able to ask why this is on his list.
  intentText     String?       @map("intent_text") @db.Text
  exchangeId     String?       @map("exchange_id") @db.Uuid
  exchange       Exchange?     @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  interventionId String?       @map("intervention_id") @db.Uuid
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  planItems PlanItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([userId, parentId])
  @@map("goals")
}

/// "This one waits for that one." A table rather than a column because a goal
/// can wait on several, and several can wait on it.
model GoalBlock {
  goalId    String @map("goal_id") @db.Uuid
  goal      Goal   @relation("blocked", fields: [goalId], references: [id], onDelete: Cascade)
  blockerId String @map("blocker_id") @db.Uuid
  blocker   Goal   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([goalId, blockerId])
  @@index([blockerId])
  @@map("goal_blocks")
}

enum GoalKind {
  /// A number to move: ApoB down, B12 up, waist down.
  outcome
  /// Something done or not done, day after day: no alcohol, in bed by midnight.
  behaviour
  /// Holds other goals and has no measure of its own. "Go meds free" is this.
  container
}

enum GoalDirection {
  down
  up
  /// Reach a value and hold it, rather than pass it.
  reach
  /// Stop doing something entirely.
  stop
  /// Keep it where it is. Harder than it sounds, and a real goal.
  maintain
}

enum GoalStatus {
  /// Heard in conversation, not yet confirmed by him. Nothing is a goal until
  /// he says it is.
  proposed
  /// Confirmed, but there is no honest starting number yet.
  waiting_baseline
  /// Waiting on another goal to finish first.
  blocked
  active
  achieved
  abandoned
}

/// The tree someone identifies with, and the farm it stands in.
///
/// The core bet of the PRD: people care for what they chose and named. A tree
/// picked in a quiz, named by its owner, standing beside friends' trees, holds
/// attention where points and streaks do not.
///
/// The quiz asks about temperament, never health. "A free Sunday morning: where
/// are you?" is a fair question; anything about symptoms would make the choice
/// of tree a disclosure.
model Farm {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tree     TreeKind
  /// Named by its owner. A named tree is harder to abandon.
  treeName String   @map("tree_name")

  /// The quiz result can be rejected. Choice matters more than quiz accuracy,
  /// so this records what was suggested and what was taken.
  suggested TreeKind? 

  createdAt DateTime @default(now()) @map("created_at")

  neighboursOut Neighbour[] @relation("from")
  neighboursIn  Neighbour[] @relation("to")

  @@map("farms")
}

enum TreeKind {
  banyan
  mango
  neem
  cherry
  oak
  bamboo
  baobab
}

/// Two farms side by side.
///
/// A link, not a follow: it is mutual by construction, created once and read
/// from both ends. Neighbours see EARNED REWARDS ONLY - never problem states,
/// quests, records or conversation - and a farm missing a reward must look
/// identical to one that has not unlocked it.
model Neighbour {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromId String @map("from_id") @db.Uuid
  from   Farm   @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String @map("to_id") @db.Uuid
  to     Farm   @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fromId, toId])
  @@index([toId])
  @@map("neighbours")
}

/// An invitation, and the referral it may become.
///
/// The free month lands only after the invited friend's first payment clears.
/// Rewarding a signup invites self-referral and trial-cancel loops, and a
/// discount that can be farmed stops being a discount.
model Invite {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Who sent it.
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Opaque, unguessable, and the only thing in the link. It must carry nothing
  /// about the sender's health, and nothing that identifies them to a stranger
  /// who guesses a code.
  code     String @unique

  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at")
  /// Set when their first payment clears, never at signup.
  rewardedAt   DateTime? @map("rewarded_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("invites")
}

/// Someone allowed to see more than a neighbour does.
///
/// The person being seen controls everything; the person watching controls
/// nothing. Sharing is per category and each one is off until deliberately
/// turned on, because a default that shares is a default nobody chose.
model CareLink {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Whose record is being shared.
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("careOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Who may look.
  viewerId String @map("viewer_id") @db.Uuid
  viewer   User   @relation("careViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  /// Exactly what they may see. Never a role, never a level: a named list, so
  /// the owner's screen can show it back to them in the same words they chose.
  seeCheckIn   Boolean @default(false) @map("see_check_in")
  seeDoses     Boolean @default(false) @map("see_doses")
  seeProblems  Boolean @default(false) @map("see_problems")
  seeQuietDays Boolean @default(false) @map("see_quiet_days")
  /// After how many silent days their circle is told to call. Their number, not
  /// ours.
  quietAfterDays Int @default(3) @map("quiet_after_days")

  /// Paused rather than deleted: the viewer is told only that sharing has
  /// paused, never why, and the owner can restart it without re-explaining.
  pausedAt  DateTime? @map("paused_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([ownerId, viewerId])
  @@index([viewerId])
  @@map("care_links")
}

/// Something true about this person that nobody told them.
///
/// The top-tier reward in the PRD: "you sleep 40 minutes longer on days you walk
/// before 6pm". Kept as a card once found, because a finding that disappears
/// when the data shifts was never worth showing.
model Discovery {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A stable key for the pair it relates, so the same finding is not collected
  /// twice under two wordings.
  key   String
  title String
  /// The numbers behind it, kept so it can be checked rather than believed.
  detail String @db.Text
  /// How many days of data it rests on. Shown, because a pattern from four days
  /// is a coincidence with a nice sentence attached.
  days Int

  foundAt DateTime @default(now()) @map("found_at")

  @@unique([userId, key])
  @@map("discoveries")
}

/// Whether someone is paying, and what happens when they stop.
///
/// A lapse rests the farm under mist and preserves it whole. What it never
/// touches: records stay readable, exportable and deletable, and medication
/// reminders keep working. A person's medical data is never held behind a
/// paywall, and safety is never a paid feature.
model Subscription {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      SubStatus @default(trialing)
  trialEndsAt DateTime? @map("trial_ends_at")
  renewsAt    DateTime? @map("renews_at")
  /// Free months earned by referral, spent before any charge.
  freeMonths  Int       @default(0) @map("free_months")

  /// Whatever the payment provider calls this person, once one exists. Null
  /// until then, which is the whole of billing that cannot be built here.
  providerRef String? @map("provider_ref")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

enum SubStatus {
  trialing
  active
  lapsed
}
