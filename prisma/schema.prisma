// outplan backend schema.
//
// Prisma owns the ordinary relational models here. It does NOT own the
// knowledge tree: ltree paths, generated tsvector columns and pgvector live in
// raw SQL migrations and are read through $queryRaw in a repository layer.
// See .claude/tech-stack.md for why, and for what was rejected.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here. Prisma 7 removed it: the connection string lives in
  // prisma.config.ts for Migrate, and reaches the client through the pg adapter
  // in src/lib/prisma.ts. One source, read once, in env.config.
}

enum Role {
  member
  clinician
  admin
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      Role     @default(member)
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @map("created_at")

  exchanges   Exchange[]
  corrections Correction[]
  sessions    AuthSession[]

  @@map("users")
}

/// One signed-in device.
///
/// Firebase alone cannot answer "where am I logged in" or "log out that phone"
/// - it has no way to enumerate a user's live tokens, and revokeRefreshTokens
/// kills every device at once. This table is what makes both possible, and for
/// a record holding someone's medications that is not a nicety.
///
/// A request must carry BOTH a valid Firebase token and a live session id. A
/// stolen token alone is therefore not enough, which is a security gain on top
/// of the feature.
model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the person will recognise in a list: "Chrome on macOS".
  label     String?
  userAgent String? @map("user_agent") @db.Text

  /// Kept for "signed in from somewhere new", not for geolocation. Truncated to
  /// a /24 before storage - enough to notice a change, not enough to place
  /// someone at an address.
  ipPrefix String? @map("ip_prefix")

  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  /// Revoked rather than deleted. "This device was signed out at 3am" is
  /// something the person may need to see afterwards, and a deleted row cannot
  /// tell them.
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by")

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// One thing the person said, and what came back.
///
/// `said` is stored BEFORE anything interprets it. The parse, the engine state
/// and the reply are all derived columns - if any of them is wrong, the
/// original is still here to derive again. A record that keeps only the
/// interpretation cannot be re-read when the interpreter turns out to be wrong,
/// and this interpreter has been wrong five times in ten days.
model Exchange {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  said   String   @db.Text
  saidAt DateTime @default(now()) @map("said_at")
  /// 'YYYY-MM-DD' in the PERSON'S timezone, as text rather than a date column.
  /// A date read back by a client in another zone can shift by a day, and "which
  /// day did I eat that" must not depend on where the reader is standing. Text
  /// sorts and ranges correctly and cannot be reinterpreted.
  localDay String @map("local_day") @db.VarChar(10)

  /// What the deterministic engines made of it: parsed meal, totals, flags,
  /// which rules fired. Null means nothing recognised it, which is a fact worth
  /// keeping rather than an absence to fill in later.
  parsed Json?

  /// What was replied, and what produced it. promptVersion and model are here so
  /// a bad answer can be traced to the configuration that produced it - without
  /// them, an eval cannot tell a prompt regression from a model change.
  replied       String?  @db.Text

  /// The reply as it should be SHOWN: a short sequence of message bubbles, and
  /// optionally one question with tappable options.
  ///
  /// `replied` stays the flat joined text, because that is what the next turn's
  /// history needs - a model reading its own previous answer does not need to
  /// know it arrived in three bubbles. Rendering and remembering are different
  /// jobs and this is the seam between them.
  ///
  /// Shape: { messages: string[], question?: { text: string, options: string[] } }
  replyParts    Json?    @map("reply_parts")

  repliedAt     DateTime? @map("replied_at")
  model         String?
  promptVersion String?  @map("prompt_version")

  corrections Correction[]

  @@index([userId, localDay])
  @@map("exchanges")
}

/// The person telling us we were wrong, and what was right instead.
///
/// A ROW, never an edit. The original reply stays. A wrong answer plus the
/// correct one plus the reason is the training pair, and editing the original
/// destroys the half that is hard to get. This is the only data in this product
/// that cannot be bought.
model Correction {
  id         String   @id @default(uuid()) @db.Uuid
  exchangeId String   @map("exchange_id") @db.Uuid
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// In the person's own words. Not a category, not a rating.
  wasWrong  String  @map("was_wrong") @db.Text
  isRight   String? @map("is_right") @db.Text

  /// Which knowledge branch this bears on, for later grouping. Nullable: forcing
  /// a domain at capture time would make the person classify their own
  /// correction, and a misfiled correction is worse than an unfiled one.
  domain String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("corrections")
}

/// Runtime configuration, changeable without a redeploy.
///
/// Only three things stay in the environment: DATABASE_URL, and the two
/// Anthropic values. Everything else lives here - the owner's instruction, and
/// the right call: a CORS origin or a model name that requires a rebuild to
/// change is not configuration, it is a constant with extra steps.
///
/// Values are jsonb so a setting can be a string, a number, a list or an object
/// without a schema change every time one is added.
model AppConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("app_config")
}

/// A system prompt, versioned.
///
/// Prompts live here rather than in source for one reason that matters: an
/// answer must be traceable to the exact text that produced it. Exchange stores
/// promptVersion, so when a reply turns out to be wrong it is possible to say
/// which prompt said it - and an eval can tell a prompt regression apart from a
/// model change. A prompt edited in place makes both impossible.
///
/// Rows are never updated. A change is a new version; activation moves.
model Prompt {
  id      String @id @default(uuid()) @db.Uuid
  key     String
  version Int

  content String  @db.Text
  notes   String? @db.Text

  /// Exactly one version per key is active. Enforced by a partial unique index
  /// in a raw migration - Prisma cannot express "unique where active".
  active Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, active])
  @@map("prompts")
}
