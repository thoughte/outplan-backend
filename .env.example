# ---- required. No default: the process refuses to start without it ----
DATABASE_URL=

NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata

# Comma-separated. Empty means same-origin only - never reflect the request
# origin, this API carries one person's health record.
CORS_ORIGINS=

# ---- reasoning path. Claude only; no small model is ever on this path ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
REASONING_MODEL=claude-sonnet-5
