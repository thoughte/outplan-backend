# THREE VARIABLES. That is the whole list.
#
# Everything else - CORS origins, the reasoning model, timezone, limits - lives
# in the app_config table and is changeable without a redeploy. A value that
# needs a rebuild to change is not configuration, it is a constant with extra
# steps.

# How the rest of the configuration is reached. No default: the process refuses
# to start without it.
DATABASE_URL=

# Secrets. These stay here rather than in the database, because a secret in a
# table is readable by anything that can read the table.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
